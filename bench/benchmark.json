    {
      "name": "acunetix-aspnet",
      "type": "public",
      "target": "testaspnet.vulnweb.com",
      "mode": "black",
      "scope_types": "web,api",
      "budget_sec": 500,
      "enabled": true,
      "note": "Public authorized Acunetix site; testaspnet has documented SQLi on multiple endpoints (Comments.aspx, ReadNews.aspx, ...), so the SQLi expectation is credited on a host-level match rather than one exact path.",
      "expected": [
        {
          "class": "sqli",
          "path": "/ (any \u2014 ReadNews/Comments/...)",
          "param": "id",
          "sev": "c",
          "match": "host"
        }
      ]
    },
    {
      "name": "auth-lab",
      "type": "agent",
      "launch": {
        "module": "bench/authlab.py",
        "port": 8982,
        "health": "/"
      },
      "target": "http://127.0.0.1:8982",
      "token": "Bearer tok-alice",
      "token2": "Bearer tok-bob",
      "objective": "You are alice (A). Prove cross-account IDOR/BOLA by reading another user's order (card/total) at /api/orders/{id}, and prove BFLA by listing every account as a non-admin at /api/admin/users. Use /api and /api/me to orient.",
      "budget_sec": 240,
      "max_steps": 16,
      "note": "Authenticated lab with planted access-control bugs; scored on whether the exploit agent PROVES the class.",
      "expected": [
        {
          "class": "idor",
          "path": "/api/orders",
          "sev": "h"
        },
        {
          "class": "bfla",
          "path": "/api/admin/users",
          "sev": "h"
        }
      ]
    },
    {
      "name": "testphp-vulnweb",
      "target": "http://testphp.vulnweb.com",
      "type": "public",
      "enabled": false,
      "budget_sec": 600,
      "expected": [
        {
          "class": "sqli",
          "path": "/listproducts.php",
          "param": "cat",
          "sev": "c"
        },
        {
          "class": "xss",
          "path": "/search.php",
          "param": "test",
          "sev": "m"
        }
      ]
    },
    {
      "name": "testhtml5-vulnweb",
      "target": "http://testhtml5.vulnweb.com",
      "type": "public",
      "enabled": false,
      "budget_sec": 600,
      "expected": [
        {
          "class": "xss",
          "path": "/",
          "param": "",
          "sev": "m"
        }
      ]
    }
  ]
}