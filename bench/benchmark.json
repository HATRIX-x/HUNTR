{
  "name": "HUNTR core benchmark v1",
  "description": "Known-vulnerable targets with exact ground truth. Local labs have planted bugs (ground truth certain); public targets are authorized Acunetix test sites.",
  "suites": [
    {
      "name": "local-lab",
      "type": "local",
      "launch": {
        "module": "bench/labs.py",
        "port": 8980,
        "health": "/"
      },
      "target": "127.0.0.1:8980",
      "mode": "black",
      "scope_types": "web,api",
      "budget_sec": 600,
      "expected": [
        {
          "class": "sqli",
          "path": "/product",
          "param": "id",
          "sev": "c"
        },
        {
          "class": "xss",
          "path": "/search",
          "param": "q",
          "sev": "m"
        },
        {
          "class": "redirect",
          "path": "/go",
          "param": "url",
          "sev": "m"
        },
        {
          "class": "ssti",
          "path": "/greet",
          "param": "name",
          "sev": "c"
        },
        {
          "class": "ssrf",
          "path": "/fetch",
          "param": "url",
          "sev": "h"
        },
        {
          "class": "idor",
          "path": "/account",
          "param": "uid",
          "sev": "h"
        },
        {
          "class": "authz",
          "path": "/admin",
          "param": "debug",
          "sev": "c"
        },
        {
          "class": "cors",
          "path": "/api/data",
          "param": "",
          "sev": "m"
        },
        {
          "class": "lfi",
          "path": "/download",
          "param": "file",
          "sev": "h"
        },
        {
          "class": "nosqli",
          "path": "/lookup",
          "param": "name",
          "sev": "h"
        },
        {
          "class": "crlf",
          "path": "/setlang",
          "param": "lang",
          "sev": "m"
        },
        {
          "class": "host-header",
          "path": "/reset",
          "param": "email",
          "sev": "m"
        },
        {
          "class": "clickjack",
          "path": "/",
          "param": "",
          "sev": "l"
        },
        {
          "class": "cmdi",
          "path": "/ping",
          "param": "host",
          "sev": "c"
        },
        {
          "class": "prototype-pollution",
          "path": "/merge",
          "param": "",
          "sev": "h"
        },
        {
          "class": "web-cache-deception",
          "path": "/profile",
          "param": "",
