        },
        {
          "class": "mass-assignment",
          "path": "/api/user",
          "param": "",
          "sev": "h"
        },
        {
          "class": "ldap",
          "path": "/ldapsearch",
          "param": "user",
          "sev": "h"
        },
        {
          "class": "xpath",
          "path": "/xpathsearch",
          "param": "q",
          "sev": "h"
        },
        {
          "class": "csp",
          "path": "/cvp",
          "param": "",
          "sev": "l"
        },
        {
          "class": "oauth",
          "path": "/oauth/authorize",
          "param": "redirect_uri",
          "sev": "h"
        },
        {
          "class": "file-upload",
          "path": "/upload",
          "param": "",
          "sev": "h"
        },
        {
          "class": "deserialization",
          "path": "/deser",
          "param": "",
